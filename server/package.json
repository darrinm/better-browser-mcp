  "type": "module",
  "bin": {
    "browser-driver-mcp": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "install-host": "node install-host.js",
    "uninstall-host": "node install-host.js --uninstall"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
