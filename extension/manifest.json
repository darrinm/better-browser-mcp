{
  "manifest_version": 3,
  "name": "Better Browser MCP",
  "version": "0.5.0",
  "description": "Drives this browser via the Chrome DevTools Protocol for local MCP clients, through a native messaging host.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "offscreen",
    "webNavigation",
    "downloads",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Better Browser MCP",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
